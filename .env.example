# Nebius Token Factory — Nebius × NVIDIA adapter (lib/model.ts) and the
# benchmark harness (scripts/benchmark.mjs). Variable names only; never
# commit real values. Copy to .env and fill in locally.
#
# Get a key: sign up at https://tokenfactory.nebius.com/ , then
# API keys section -> Create API key. The key is shown once — save it.
NEBIUS_API_KEY=

# Optional. Model ID on Token Factory.
# Default: nvidia/nemotron-3-super-120b-a12b (Nemotron 3 Super, text).
# Also served: nvidia/Nemotron-3.5-Super-VL (vision-language; the one model
# with a verified published price wired into data/verified-pricing.json).
NEBIUS_MODEL=

# Optional. Default: https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=
